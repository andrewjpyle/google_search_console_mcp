# Google Search Console MCP — credentials
# Choose ONE of the two auth methods below.

# ── Option A: OAuth2 (a user's own Google account) ───────────────────────────
# Create an OAuth client in Google Cloud Console, grant the Search Console API,
# and generate a refresh token with the webmasters scope.
GOOGLE_SEARCH_CONSOLE_CLIENT_ID=
GOOGLE_SEARCH_CONSOLE_CLIENT_SECRET=
GOOGLE_SEARCH_CONSOLE_REFRESH_TOKEN=

# ── Option B: Service account (recommended for automation) ───────────────────
# Paste the FULL service-account JSON as a single-line string, then add the
# service-account email as a user on each Search Console property.
# GOOGLE_SEARCH_CONSOLE_CREDENTIALS={"type":"service_account", ... }

# ── Site scope (optional) ────────────────────────────────────────────────────
# Comma-separated list of properties this server may act on. The first is the
# default when a tool call omits site_url.
GOOGLE_SEARCH_CONSOLE_SITE_URLS=https://example.com/
# Optional explicit default (overrides the first of SITE_URLS):
# GOOGLE_SEARCH_CONSOLE_SITE_URL=https://example.com/
