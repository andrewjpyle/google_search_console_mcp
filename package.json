{
  "name": "google-search-console-mcp",
  "version": "1.1.0",
  "description": "A Model Context Protocol (MCP) server for Google Search Console: search analytics, URL inspection, and sitemaps for AI assistants. Real API calls only.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "google-search-console-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "keywords": [
    "mcp",
    "model-context-protocol",
    "google-search-console",
    "gsc",
    "seo",
    "claude",
    "ai-tools",
    "indexing",
    "sitemaps"
  ],
  "author": "Andrew J. Pyle",
  "license": "MIT",
  "homepage": "https://github.com/andrewjpyle/google_search_console_mcp",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/andrewjpyle/google_search_console_mcp.git"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "test": "jest",
    "test:unit": "jest tests/unit",
    "test:e2e": "jest tests/e2e",
    "test:coverage": "jest --coverage",
    "test:watch": "jest --watch",
    "call": "node scripts/call-tool.mjs",
    "pretest": "tsc"
  },
  "dependencies": {
    "@googleapis/searchconsole": "^3.0.0",
    "@modelcontextprotocol/sdk": "^1.31.0",
    "dotenv": "^16.6.1",
    "google-auth-library": "^9.4.1",
    "googleapis": "^134.0.0",
    "winston": "^3.15.0",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^20.11.5",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  }
}
